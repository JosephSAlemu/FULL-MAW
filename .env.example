# Copy to .env and fill in. Every line must be KEY=VALUE -- python-dotenv skips
# anything else. Comment out an optional variable rather than leaving a
# placeholder in it; a non-empty placeholder is read as a real value.

# __ Required: the LLM backend (any OpenAI-compatible endpoint) ________________
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# The Explorer's code-generation model. Falls back to MODEL_NAME.
# CODER_MODEL_NAME=

# __ Required for --env multi-node: the PBS project to charge __________________
# PBS_ACCOUNT=

# __ Optional __________________________________________________________________

# Which ADIOS2 `--engine adios` exposes. DEFAULT serial, and what any unset or
# unrecognised value falls back to.
#   serial  PyPI wheel, SST over TCP, no MPI. Works whatever MPI a domain names.
#           Tools: run_pipeline, write_bp, read_bp. One file PER STAGE.
#   mpi     the +mpi build under spack_mpi/, loaded as a module by each task.
#           MPMD and collective writes, bound to one MPI. Tools: run_mpmd,
#           write_stage. The server refuses to start without the generated
#           module, so leave this commented until you have built it.
# MAW_ADIOS=serial

# Archive root for finished runs, outside the repo. UNSET MEANS NO ARCHIVING.
# MAW_ARCHIVE_ROOT=

# Explicit path to share/spack/setup-env.sh for a multi-node worker.
# MAW_SPACK_SETUP=

# Move a non-empty work/run0 aside instead of writing over it.
# MAW_ROTATE_RUN0=1

# Cap on the paper text given to the planner (default 120000 characters).
# MAW_PDF_MAX_CHARS=120000

# How many times the orchestrator may send ONE agent back, per run. Default 1.
# Only the planner and the explorer are revisable; the installer is corrected
# with a package list instead.
# MAW_MAX_REVISIONS=1
